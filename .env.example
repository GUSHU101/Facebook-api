# 内部 Node.js 端口。不要直接暴露到公网。
PORT=3000

DATABASE_URL=postgres://capi_saas:capi_saas@127.0.0.1:5432/capi_saas
REDIS_URL=redis://127.0.0.1:6379

FB_API_VERSION=v25.0

AES_SECRET_KEY=replace_with_a_32_plus_character_random_secret

# 用于公网商店路由令牌的独立轮换密钥边界。
INGEST_TOKEN_SECRET=replace_with_another_32_plus_character_random_secret

# 可选：保留旧密钥，使已经安装的像素在密钥轮换期间仍然正常工作。
INGEST_TOKEN_PREVIOUS_SECRET=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=GUshu1906@

REQUIRE_INGEST_TOKEN=true

# 只有这些 Shopify 订单来源 source_name 允许创建网站 Purchase（购买）事件。
# 如果需要支持已验证的无头商店/自定义销售渠道，请明确添加对应 source。
SHOPIFY_WEB_ORDER_SOURCES=web

# 可选：当多个商店使用同一个自定义应用时，可以填写共享 Client Secret。
# 如果每个商店在后台都有独立 Secret，则留空。
SHOPIFY_APP_SECRET=

SHOPIFY_API_VERSION=2026-07

SHOPIFY_RECONCILE_CRON="23 */15 * * * *"

SHOPIFY_RECONCILE_LOOKBACK_HOURS=48

SHOPIFY_RECONCILE_MAX_ORDERS=1000

SHOPIFY_RECONCILE_MAX_LINE_ITEM_PAGES=100


# 可选的生产环境调优参数

# Shopify Customer Events（客户事件）运行在沙盒环境中，
# 因此保持 * 最安全，除非已经实际测量过真实 Origin 来源。
# CORS 仅对无 Cookie 的像素采集接口路由启用。
CORS_ORIGIN=*

TRUST_PROXY_HOPS=1

JSON_LIMIT=1mb

# 单个电商事件中最多保留的商品行数量。
# 超过该值会被诊断为数据截断。
# 1000 可以支持跨多个 Shopify 页面的大型订单。
COMMERCE_ITEM_LIMIT=1000

HTTP_REQUEST_TIMEOUT_MS=30000

HTTP_HEADERS_TIMEOUT_MS=15000

HTTP_KEEP_ALIVE_TIMEOUT_MS=5000

SHUTDOWN_TIMEOUT_MS=120000

DB_POOL_MAX=20

DB_IDLE_TIMEOUT_MS=30000

DB_CONNECTION_TIMEOUT_MS=10000

DB_STATEMENT_TIMEOUT_MS=30000

DB_POOL_MAX_USES=7500

BATCH_SIZE=1000

# 是否启用旧版 Redis 排空机制。
LEGACY_REDIS_DRAIN_ENABLED=false

WORKER_EVENT_BATCH_SIZE=100

QUEUE_ATTEMPTS=5

QUEUE_BACKOFF_MS=5000


# 每个商店/每个 IP 每分钟允许的最大事件数量（批量事件也会计数）。
# 如果已经正确配置 CDN/WAF 限流，可以设置为 0。
PIXEL_RATE_LIMIT_PER_MINUTE=600

ADMIN_RATE_LIMIT_PER_WINDOW=100


# Shopify Webhook 收件箱定时任务
SHOPIFY_WEBHOOK_INBOX_CRON="*/5 * * * * *"

SHOPIFY_WEBHOOK_INBOX_BATCH_SIZE=200

SHOPIFY_WEBHOOK_INBOX_MAX_ATTEMPTS=20

SHOPIFY_WEBHOOK_INBOX_LEASE_SECONDS=60


# Shopify 隐私请求处理定时任务
SHOPIFY_PRIVACY_CRON="11 */1 * * * *"

SHOPIFY_PRIVACY_BATCH_SIZE=50

SHOPIFY_PRIVACY_MAX_ATTEMPTS=20

SHOPIFY_PRIVACY_LEASE_SECONDS=120

SHOPIFY_PRIVACY_RETENTION_DAYS=30


FB_REQUEST_TIMEOUT_MS=15000

FACEBOOK_BATCH_SIZE=100

FACEBOOK_ISOLATION_MAX_REQUESTS=16


# TikTok 事件最大允许年龄（秒）
TIKTOK_MAX_EVENT_AGE_SECONDS=604800


WORKER_CONCURRENCY=20

WORKER_RATE_LIMIT_MAX=100

WORKER_RATE_LIMIT_DURATION_MS=1000


# 每个凭证（Token）每秒允许的平台 API 请求数量
PLATFORM_REQUESTS_PER_SECOND_PER_CREDENTIAL=20


# 投递失败重试基础间隔时间（秒）
DELIVERY_RETRY_BASE_SECONDS=5

# 投递失败最大重试间隔时间（秒）
DELIVERY_RETRY_MAX_SECONDS=900

# 服务端根据 Retry-After 返回的最大等待时间（秒）
DELIVERY_RETRY_AFTER_MAX_SECONDS=86400


# 0 表示临时错误会持续重试，
# 直到 Meta 的事件有效期验证机制使事件失效。
DELIVERY_MAX_ATTEMPTS=0


# 凭证租约时间（毫秒）
CREDENTIAL_LEASE_MS=60000

# 凭证繁忙时的等待延迟时间（秒）
CREDENTIAL_BUSY_DELAY_SECONDS=2


# 商店任务继续执行前的延迟时间（毫秒）
SHOP_CONTINUATION_DELAY_MS=500


# 投递恢复任务执行间隔（分钟）
DELIVERY_RESCUE_MINUTES=1

# 单次恢复任务最多处理的商店数量
DELIVERY_RESCUE_SHOP_LIMIT=500


# 聚合数据重新同步批量大小
AGGREGATE_RECONCILE_BATCH_SIZE=5000


# Purchase（购买）事件结算等待时间（毫秒）
PURCHASE_SETTLE_MS=8000


# 有限制的数据保留策略，防止 PostgreSQL 表和索引无限增长。

# 数据清理定时任务
CLEANUP_CRON="17 * * * *"

CLEANUP_BATCH_SIZE=10000

CLEANUP_MAX_BATCHES=2


# 事件数据保留天数
EVENT_RETENTION_DAYS=90

# 死信队列数据保留天数
DEAD_LETTER_RETENTION_DAYS=90

# 别名数据保留天数
ALIAS_RETENTION_DAYS=120

# 数据质量记录保留天数
QUALITY_RETENTION_DAYS=30

# 备份文件保留天数
BACKUP_RETENTION_DAYS=30


# PM2 横向扩展配置。
# PostgreSQL 总连接数大约为：
# (API实例数量 + Worker实例数量) × DB_POOL_MAX
#
# 例如：
# API_INSTANCES=2
# WORKER_INSTANCES=4
# DB_POOL_MAX=20
#
# 最大数据库连接约为：
# (2+4)×20=120
#
# 需要根据 PostgreSQL max_connections 调整。
API_INSTANCES=1

WORKER_INSTANCES=1
